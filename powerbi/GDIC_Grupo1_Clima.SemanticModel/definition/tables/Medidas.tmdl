table Medidas
	lineageTag: 93d67e74-7ae2-4235-9c71-53ea386b8ed1

	measure 'Temp Média (°C)' = AVERAGE ( clima_cidades[temp_media] )
		lineageTag: 0f05ec38-71ae-45ae-9ecd-bfe47243a223

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chuva Mensal Média (mm)' = AVERAGE ( clima_cidades[precip_total_mm] )
		lineageTag: 70058eac-aac1-4262-8cc1-8133246eafff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ONI Médio' = AVERAGE ( clima_cidades[oni] )
		lineageTag: e668895c-3fad-4132-88dd-2b75bb9d8be0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chuva vs Neutro (%)' =
			
			DIVIDE (
			    [Chuva Mensal Média (mm)],
			    CALCULATE ( [Chuva Mensal Média (mm)], clima_cidades[fase] = "Neutro" )
			) - 1
		formatString: 0%;-0%;0%
		lineageTag: 0176d4b7-0660-4822-a827-797150e41e47

	measure 'Chuva vs Normal (%)' =
			
			DIVIDE ( SUM ( clima_cidades[precip_total_mm] ), SUM ( clima_cidades[chuva_normal] ) ) - 1
		formatString: 0%;-0%;0%
		lineageTag: 1bdc1384-f4dc-4609-aef5-c606f69f9065

	measure 'Anomalia Temp (°C)' = AVERAGE ( clima_cidades[anomalia_temp] )
		lineageTag: 0d43cf53-0429-4f80-8a68-ff5fa94b0e24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nº Cidades' = DISTINCTCOUNT ( clima_cidades[cidade] )
		formatString: 0
		displayFolder: Base
		lineageTag: f459bffd-7f0a-480d-bf89-07bb4e7bdbce

	measure 'Nº Países' = DISTINCTCOUNT ( clima_cidades[pais] )
		formatString: 0
		displayFolder: Base
		lineageTag: 899d7736-6f94-4af2-9e17-8caf9297b729

	measure 'Nº Registros' = COUNTROWS ( clima_cidades )
		formatString: #,0
		displayFolder: Base
		lineageTag: 9d008e96-5e79-4866-b243-89caba9e00c9

	measure Período = MIN ( clima_cidades[ano] ) & " – " & MAX ( clima_cidades[ano] )
		displayFolder: Base
		lineageTag: 73ba029d-ab50-4841-b615-4d6d5bd532c5

	measure '% Meses El Niño' =
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( clima_cidades[data] ), clima_cidades[fase] = "El Niño" ),
			    DISTINCTCOUNT ( clima_cidades[data] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: El Niño e La Niña
		lineageTag: 4dd1c14f-0729-4374-8fa3-42111a5be568

	measure '% Meses La Niña' =
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( clima_cidades[data] ), clima_cidades[fase] = "La Niña" ),
			    DISTINCTCOUNT ( clima_cidades[data] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: El Niño e La Niña
		lineageTag: 7d2d0ff8-6178-4a39-93f3-6b090ff8aeb8

	measure 'Temp Normal (°C)' = AVERAGE ( clima_cidades[temp_normal] )
		formatString: 0.0
		displayFolder: Temperatura
		lineageTag: 8a4560bd-07a8-4d3a-9200-1ed8f52c46d0

	measure 'Anomalia Máx (°C)' = AVERAGE ( clima_cidades[anomalia_max] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Temperatura
		lineageTag: 50b1e282-351d-417f-9f35-343a4404ef0d

	measure 'Anomalia Mín (°C)' = AVERAGE ( clima_cidades[anomalia_min] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Temperatura
		lineageTag: 7b9778a8-056b-47da-88a6-0158ad9033bc

	measure 'Amplitude Térmica (°C)' = AVERAGE ( clima_cidades[amplitude_termica] )
		formatString: 0.0
		displayFolder: Temperatura
		lineageTag: cfb01dc7-1305-40c8-8c80-fd379c6cdce2

	measure 'Máxima Absoluta (°C)' = MAX ( clima_cidades[temp_max_absoluta] )
		formatString: 0.0
		displayFolder: Temperatura
		lineageTag: 1a37ad4c-ab0f-4bb6-9fff-c4834ad41d2c

	measure 'Chuva Normal (mm)' = AVERAGE ( clima_cidades[chuva_normal] )
		formatString: #,0
		displayFolder: Chuva
		lineageTag: 5616af82-850b-4380-bfc3-6d3d2cb5d031

	measure 'Chuva Anual Média (mm)' =
			AVERAGEX (
			    SUMMARIZE ( clima_cidades, clima_cidades[cidade], clima_cidades[ano] ),
			    CALCULATE ( SUM ( clima_cidades[precip_total_mm] ) )
			)
		formatString: #,0
		displayFolder: Chuva
		lineageTag: 111b435b-6c34-4ade-adae-fe60048be794

	measure 'Tendência (°C por década)' =
			VAR t = ADDCOLUMNS ( VALUES ( clima_cidades[ano] ), "@anom", [Anomalia Temp (°C)] )
			VAR reta = LINESTX ( t, [@anom], clima_cidades[ano] )
			RETURN MAXX ( reta, [Slope1] ) * 10
		formatString: +0.00;-0.00;0.00
		displayFolder: Tendência e previsão
		lineageTag: 9da26154-6eb9-4378-bc37-36e1edd9f6a2

	measure 'Anomalia Projetada 2030 (°C)' =
			VAR t = ADDCOLUMNS ( VALUES ( clima_cidades[ano] ), "@anom", [Anomalia Temp (°C)] )
			VAR reta = LINESTX ( t, [@anom], clima_cidades[ano] )
			RETURN MAXX ( reta, [Intercept] + [Slope1] * 2030 )
		formatString: +0.00;-0.00;0.00
		displayFolder: Tendência e previsão
		lineageTag: 917c5c78-5c71-494e-8c65-704b494038eb

	measure '% Meses Calor Extremo' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( clima_cidades ), clima_cidades[anomalia_temp] >= 1 ),
			    COUNTROWS ( clima_cidades )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Eventos extremos
		lineageTag: a1c3e5f7-2b4d-4f6a-8c1e-3d5f7a9b1c01

	measure '% Meses Seca Extrema' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( clima_cidades ), NOT ISBLANK ( clima_cidades[chuva_pct] ), clima_cidades[chuva_pct] <= -0.7 ),
			    CALCULATE ( COUNTROWS ( clima_cidades ), NOT ISBLANK ( clima_cidades[chuva_pct] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Eventos extremos
		lineageTag: a1c3e5f7-2b4d-4f6a-8c1e-3d5f7a9b1c02

	measure '% Meses Chuva Extrema' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( clima_cidades ), NOT ISBLANK ( clima_cidades[chuva_pct] ), clima_cidades[chuva_pct] >= 1 ),
			    CALCULATE ( COUNTROWS ( clima_cidades ), NOT ISBLANK ( clima_cidades[chuva_pct] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Eventos extremos
		lineageTag: a1c3e5f7-2b4d-4f6a-8c1e-3d5f7a9b1c03

	measure 'Recorde Extremo' =
			VAR tipo = SELECTEDVALUE ( clima_cidades[tipo_extremo] )
			VAR pontos =
			    SWITCH (
			        tipo,
			        "Chuva extrema", MAX ( clima_cidades[chuva_pct] ),
			        "Seca extrema", - MIN ( clima_cidades[chuva_pct] ),
			        "Calor extremo", MAX ( clima_cidades[anomalia_temp] )
			    )
			VAR melhor =
			    MAXX (
			        ALLSELECTED ( clima_cidades[Local] ),
			        CALCULATE (
			            SWITCH (
			                tipo,
			                "Chuva extrema", MAX ( clima_cidades[chuva_pct] ),
			                "Seca extrema", - MIN ( clima_cidades[chuva_pct] ),
			                "Calor extremo", MAX ( clima_cidades[anomalia_temp] )
			            )
			        )
			    )
			RETURN IF ( NOT ISBLANK ( pontos ) && pontos >= melhor, 1 )
		formatString: 0
		displayFolder: Eventos extremos
		lineageTag: a1c3e5f7-2b4d-4f6a-8c1e-3d5f7a9b1c04

	measure 'Recorde (detalhe)' =
			VAR tipo = SELECTEDVALUE ( clima_cidades[tipo_extremo] )
			VAR linha =
			    TOPN (
			        1,
			        clima_cidades,
			        SWITCH (
			            tipo,
			            "Chuva extrema", clima_cidades[chuva_pct],
			            "Seca extrema", - clima_cidades[chuva_pct],
			            clima_cidades[anomalia_temp]
			        ), DESC
			    )
			VAR dt = MAXX ( linha, clima_cidades[data] )
			VAR valor =
			    SWITCH (
			        tipo,
			        "Chuva extrema", FORMAT ( MAXX ( linha, clima_cidades[chuva_pct] ), "+0%" ),
			        "Seca extrema", FORMAT ( MAXX ( linha, clima_cidades[chuva_pct] ), "0%" ),
			        FORMAT ( MAXX ( linha, clima_cidades[anomalia_temp] ), "+0.0" ) & " °C"
			    )
			RETURN IF ( NOT ISBLANK ( dt ), FORMAT ( dt, "mmm/yyyy" ) & " · " & valor )
		displayFolder: Eventos extremos
		lineageTag: a1c3e5f7-2b4d-4f6a-8c1e-3d5f7a9b1c05

	column x
		isHidden
		formatString: 0
		lineageTag: 94f4439f-8fd3-4585-aeb7-60a465ae9ae6
		summarizeBy: sum
		isNameInferred
		sourceColumn: [x]

		annotation SummarizationSetBy = Automatic

	partition Medidas = calculated
		mode: import
		source = ROW ( "x", BLANK () )

	annotation PBI_Id = 6c729138e1dc4bc196ea927254b4568f

