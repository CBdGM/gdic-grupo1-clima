	column Local = clima_cidades[cidade] & ", " & clima_cidades[pais]
		lineageTag: e20f593e-470b-4fcf-8d16-4f1026e70526
		dataCategory: Place
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column temp_normal =
			
			VAR c = clima_cidades[cidade]
			VAR m = clima_cidades[mes]
			RETURN
			    CALCULATE (
			        AVERAGE ( clima_cidades[temp_media] ),
			        FILTER ( ALL ( clima_cidades ),
			            clima_cidades[cidade] = c && clima_cidades[mes] = m
			                && clima_cidades[ano] >= 1991 && clima_cidades[ano] <= 2020 )
			    )
		lineageTag: ba1ad9f9-3aaf-4ab8-ad5a-346f38bae914
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column anomalia_temp = clima_cidades[temp_media] - clima_cidades[temp_normal]
		lineageTag: a5bdf464-af6e-4560-a2b5-7cbb0695f56b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column chuva_normal =
			
			VAR c = clima_cidades[cidade]
			VAR m = clima_cidades[mes]
			RETURN
			    CALCULATE (
			        AVERAGE ( clima_cidades[precip_total_mm] ),
			        FILTER ( ALL ( clima_cidades ),
			            clima_cidades[cidade] = c && clima_cidades[mes] = m
			                && clima_cidades[ano] >= 1991 && clima_cidades[ano] <= 2020 )
			    )
		lineageTag: 94bb8080-f7bf-4bca-b140-bfd1b93e8624
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column decada = INT ( clima_cidades[ano] / 10 ) * 10
		formatString: 0
		lineageTag: b91a7b01-d956-4f09-b20e-30fe80e20a77
		summarizeBy: none

		annotation SummarizationSetBy = User

	column nome_mes = FORMAT ( clima_cidades[data], "MMM" )
		lineageTag: 1dc6c472-80c4-4e17-84d0-f358dcd28729
		summarizeBy: none
		sortByColumn: mes

		annotation SummarizationSetBy = Automatic

