	column temp_max_normal =
			VAR c = clima_cidades[cidade]
			VAR m = clima_cidades[mes]
			RETURN
			    CALCULATE (
			        AVERAGE ( clima_cidades[temp_max_media] ),
			        FILTER ( ALL ( clima_cidades ),
			            clima_cidades[cidade] = c && clima_cidades[mes] = m
			                && clima_cidades[ano] >= 1991 && clima_cidades[ano] <= 2020 )
			    )
		lineageTag: 2761d36e-51fc-46ce-85df-68d05be501c9
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column temp_min_normal =
			VAR c = clima_cidades[cidade]
			VAR m = clima_cidades[mes]
			RETURN
			    CALCULATE (
			        AVERAGE ( clima_cidades[temp_min_media] ),
			        FILTER ( ALL ( clima_cidades ),
			            clima_cidades[cidade] = c && clima_cidades[mes] = m
			                && clima_cidades[ano] >= 1991 && clima_cidades[ano] <= 2020 )
			    )
		lineageTag: fe9a813d-e3fa-40fd-b404-344d9cf868e4
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column anomalia_max = clima_cidades[temp_max_media] - clima_cidades[temp_max_normal]
		lineageTag: 7926a234-7489-46a9-906b-7fd771708559
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column anomalia_min = clima_cidades[temp_min_media] - clima_cidades[temp_min_normal]
		lineageTag: ad4b627c-f641-4a10-9959-83048f2762c0
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column amplitude_termica = clima_cidades[temp_max_media] - clima_cidades[temp_min_media]
		lineageTag: 82d07855-9cb6-4528-bc8e-c240d826998a
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column chuva_pct = IF ( clima_cidades[chuva_normal] > 30, DIVIDE ( clima_cidades[precip_total_mm], clima_cidades[chuva_normal] ) - 1 )
		formatString: 0%;-0%;0%
		lineageTag: 4b6f2a1e-8c3d-4e5f-9a7b-1c2d3e4f5a61
		summarizeBy: none

		annotation SummarizationSetBy = User

	column tipo_extremo =
			SWITCH (
			    TRUE (),
			    NOT ISBLANK ( clima_cidades[chuva_pct] ) && clima_cidades[chuva_pct] >= 1, "Chuva extrema",
			    NOT ISBLANK ( clima_cidades[chuva_pct] ) && clima_cidades[chuva_pct] <= -0.7, "Seca extrema",
			    clima_cidades[anomalia_temp] >= 1, "Calor extremo",
			    "Normal"
			)
		lineageTag: 7e2c9d4a-1b3f-4a6e-8d5c-2f3a4b5c6d72
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition clima_cidades = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\gdic-grupo1-clima\data\clima_latam_ampliado.csv"),[Delimiter=";", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"cidade", type text}, {"pais", type text}, {"data", type date}, {"ano", Int64.Type}, {"mes", Int64.Type}, {"temp_media", type number}, {"temp_max_media", type number}, {"temp_min_media", type number}, {"temp_max_absoluta", type number}, {"precip_total_mm", type number}, {"dias_chuva", Int64.Type}, {"oni", type number}, {"fase", type text}, {"intensidade", type text}, {"evento_enso", type text}}),
				    #"Ordem Fase" = Table.AddColumn(#"Tipo Alterado", "ordem_fase", each if [fase] = "La Niña" then 1 else if [fase] = "Neutro" then 2 else 3, Int64.Type),
				    #"Ordem Intensidade" = Table.AddColumn(#"Ordem Fase", "ordem_intensidade", each if [intensidade] = "Fraco" then 1 else if [intensidade] = "Moderado" then 2 else if [intensidade] = "Forte" then 3 else if [intensidade] = "Muito forte" then 4 else 0, Int64.Type)
				in
				    #"Ordem Intensidade"

	annotation PBI_NavigationStepName = Navegação

